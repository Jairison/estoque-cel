rules_version = '2';

// Império Cell — regras de segurança do Cloud Firestore.
// Cole este conteúdo em: Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function userPath() { return docPath('users', request.auth.uid); }
    function ownerPath() { return docPath('meta', 'owner'); }
    function privatePath() { return docPath('settings', 'private'); }
    function data() { return request.resource.data; }

    // Usuário com cadastro ativo (aprovado e não desativado)
    function active() { return signedIn() && exists(userPath()) && get(userPath()).data.status == 'active'; }
    function isAdmin() { return active() && get(userPath()).data.role == 'admin'; }
    // Estado após a gravação: permite ao 1º administrador criar tudo num único lote
    function isAdminAfter() {
      return signedIn() && existsAfter(userPath())
        && getAfter(userPath()).data.role == 'admin' && getAfter(userPath()).data.status == 'active';
    }
    function onlyChanged(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }
    function text(v, max) { return v is string && v.size() <= max; }

    // Dono do sistema (1º administrador). Só pode ser criado uma vez.
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && data().uid == request.auth.uid && data().keys().hasOnly(['uid', 'at']);
    }

    // Nome da loja e catálogo: leitura pública (tela de login), alteração só pelo admin
    match /settings/public {
      allow read: if true;
      allow write: if isAdminAfter();
    }
    // Código da loja: só o admin vê
    match /settings/private {
      allow read: if isAdmin();
      allow write: if isAdminAfter();
    }

    match /users/{uid} {
      function validUser() {
        return data().keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt', 'lastLogin', 'joinCode'])
          && text(data().name, 60) && data().name.size() > 0
          && text(data().email, 120)
          && data().role in ['admin', 'colaborador']
          && data().status in ['active', 'pending', 'disabled'];
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if validUser() && (isAdmin() || (
        signedIn() && request.auth.uid == uid
        && data().email == request.auth.token.email
        && (
          // 1º acesso: o primeiro cadastro vira o administrador principal
          (data().role == 'admin' && data().status == 'active'
            && !exists(ownerPath()) && existsAfter(ownerPath()) && getAfter(ownerPath()).data.uid == uid)
          // Cadastro sem código: aguarda aprovação
          || (data().role == 'colaborador' && data().status == 'pending')
          // Cadastro com o código da loja correto: acesso liberado na hora
          || (data().role == 'colaborador' && data().status == 'active'
            && exists(privatePath()) && data().joinCode == get(privatePath()).data.joinCode)
        )
      ));
      // A própria pessoa só pode atualizar o horário do último acesso
      allow update: if (isAdmin() && validUser()) || (signedIn() && request.auth.uid == uid && onlyChanged(['lastLogin']));
      allow delete: if isAdmin();
    }

    // Aparelhos: todos os usuários ativos veem (sem preços).
    // O colaborador só pode dar saída, e somente junto com a movimentação de saída que lista o aparelho.
    match /units/{id} {
      allow read: if active();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        active() && resource.data.status == 'disponivel' && data().status == 'saida'
        && onlyChanged(['status', 'outAt', 'outMovementId', 'updatedAt'])
        && data().outMovementId is string
        && existsAfter(docPath('movements', data().outMovementId))
        && getAfter(docPath('movements', data().outMovementId)).data.userId == request.auth.uid
        && getAfter(docPath('movements', data().outMovementId)).data.unitIds.hasAny([id])
      );
    }

    // Custo, preço, fornecedor e observações: somente o admin
    match /unitPrices/{id} {
      allow read, write: if isAdmin();
    }

    // Movimentações: o colaborador vê e cria apenas as próprias saídas, sem valores,
    // e a saída precisa corresponder a aparelhos que de fato saíram nesta mesma gravação.
    match /movements/{id} {
      allow read: if isAdmin() || (active() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        active()
        && data().keys().hasOnly(['type', 'at', 'userId', 'userName', 'reason', 'customer', 'note', 'unitIds', 'items', 'qty', 'reverted'])
        && data().userId == request.auth.uid
        && data().userName == get(userPath()).data.name
        && data().type == 'saida' && data().reverted == false
        && data().qty is int && data().qty >= 1 && data().qty <= 500
        && data().unitIds is list && data().unitIds.size() == data().qty
        && data().items is list && data().items.size() == data().qty
        && text(data().reason, 40) && text(data().customer, 80) && text(data().note, 300)
        && getAfter(docPath('units', data().unitIds[0])).data.outMovementId == id
        && getAfter(docPath('units', data().unitIds[data().qty - 1])).data.outMovementId == id
      );
      allow update, delete: if isAdmin();
    }

    // Auditoria: só quem tem cadastro registra as próprias ações (com o próprio nome); só o admin lê
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && existsAfter(userPath())
        && data().keys().hasOnly(['at', 'userId', 'userName', 'action', 'detail'])
        && data().userId == request.auth.uid
        && text(data().action, 40) && text(data().detail, 2000)
        && (isAdminAfter() || data().userName == getAfter(userPath()).data.name);
    }
  }
}
